<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.4.0</Version>
		<Description>use C# interface to generate grpc protocol file、server、controller、restfulapi、swagger、ts model</Description>
		<PackageProjectUrl>https://github.com/ad313/GRpcProtocolGenerator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ad313/GRpcProtocolGenerator</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>ad313</Authors>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="Renders\Templates\*.txt" />
		<EmbeddedResource Include="Renders\Templates\*.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Namotion.Reflection" Version="3.5.1" />
		<PackageReference Include="Scriban" Version="7.5.1" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\GRpcProtocolGenerator.Common\GRpcProtocolGenerator.Common.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- 允许测试项目访问内部类型（如 ScribanHelper）以验证模板渲染 -->
		<InternalsVisibleTo Include="GRpcProtocolGenerator.Test" />
	</ItemGroup>
</Project>
